# Medhas — Unified Multi-AGI Memory Engine example environment file.
# Copy to .env and fill in real values. .env is git-ignored; this file is committed.

# --- Required: Groq API key for LLM inference (dream cycle, background extraction, turns) ---
GROQ_API_KEY=your_groq_api_key_here

# --- Database (must match docker-compose.yml / your Postgres instance) ---
POSTGRES_USER=agent_user
POSTGRES_PASSWORD=agent_password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=unified_memory

# --- Model / embedding tuning (optional) ---
GROQ_MODEL=llama-3.3-70b-versatile
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
